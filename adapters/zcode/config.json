{
  "mcp": {
    "servers": {
      "memai": {
        "type": "stdio",
        "command": "npx",
        "args": ["-y", "-p", "memai-cli", "memai-mcp"],
        "timeoutMs": 30000
      }
    }
  },
  "hooks": {
    "enabled": true,
    "events": {
      "SessionStart": [
        {
          "matcher": "startup|resume",
          "hooks": [
            {
              "type": "process",
              "command": "npx",
              "args": ["-y", "-p", "memai-cli", "memai", "hook", "card"],
              "timeoutMs": 20000
            },
            {
              "type": "process",
              "command": "npx",
              "args": ["-y", "-p", "memai-cli", "memai", "watch", "--ensure"],
              "timeoutMs": 10000
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Edit|Write|MultiEdit",
          "hooks": [
            {
              "type": "process",
              "command": "npx",
              "args": ["-y", "-p", "memai-cli", "memai", "hook", "index"],
              "timeoutMs": 15000
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "matcher": "Read|read_file",
          "hooks": [
            {
              "type": "process",
              "command": "npx",
              "args": ["-y", "-p", "memai-cli", "memai", "hook", "guard"],
              "timeoutMs": 15000
            }
          ]
        }
      ]
    }
  }
}
